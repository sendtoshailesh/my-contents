# Environment Configuration Example

# ⚠️  IMPORTANT: Secrets are NOT stored in .env anymore!
# 
# Instead, secrets are stored securely in:
#   • macOS: Keychain.app (OS native)
#   • Windows: Credential Manager (OS native)
#
# To setup secrets, run:
#   python scripts/setup_secrets.py
#
# This .env file is for NON-SECRET configuration only.
# ========================================================

# Database
DATABASE_PATH=~/.content-studio/sessions.db
MAX_SESSIONS=10

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4-turbo
FALLBACK_LLM_MODEL=claude-3.5-sonnet
LLM_TEMPERATURE_CREATIVE=0.7
LLM_TEMPERATURE_FACTUAL=0.3

# Search Configuration
SEARCH_PROVIDER=bing
SEARCH_CONFIDENCE_THRESHOLD=0.70
MAX_SEARCH_RESULTS=5

# Platform Configuration
SUPPORTED_PLATFORMS=linkedin,twitter,reddit,medium,substack,instagram

# Logging
LOG_LEVEL=INFO
LOG_FILE=~/.content-studio/app.log

# Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Optional: Azure Key Vault Fallback (for multi-device sync)
# Only set if you want to use Key Vault as fallback
# AZURE_KEYVAULT_NAME=kv-content-studio-xxxxx
# AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Frameworks Configuration
FRAMEWORK_CONFIG_FILE=~/.content-studio/frameworks.yaml
VISUAL_CONFIG_FILE=~/.content-studio/visuals.yaml

# Feature Flags
ENABLE_VISUAL_GENERATION=true
ENABLE_CODE_SNIPPETS=false
ENABLE_CONTENT_MODERATION=false

# Performance
SQLALCHEMY_ECHO=false
ASYNC_POOL_SIZE=5
ASYNC_MAX_OVERFLOW=10

# ========================================================
# HOW TO USE THIS FILE:
# ========================================================
# 
# 1. Copy this to .env in the root directory:
#    cp .env.example .env
#
# 2. Edit .env with your NON-SECRET configuration
#
# 3. For secrets (API keys, tokens):
#    - DO NOT add them here
#    - Run: python scripts/setup_secrets.py
#    - Secrets will be stored in OS keychain
#
# 4. Add .env to .gitignore (if not already)
#
# ========================================================
# SECURITY NOTES:
# ========================================================
#
# ✅ GOOD: Non-secret config in .env
# ✅ GOOD: Secrets in OS keychain (via keyring)
# ✅ GOOD: .env in .gitignore
#
# ❌ BAD:  API keys in .env
# ❌ BAD:  Commit .env to git
# ❌ BAD:  Store secrets in plain text files
#
# ========================================================
